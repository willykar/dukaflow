# Copy to .env and fill in. Never commit .env.

# Phase 1: PostgreSQL (docker-compose defaults)
POSTGRES_URL=postgresql://duka:duka@localhost:5432/dukaflow

# Phase 2: Kafka and the till gateway
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_SALES=pos.sales
KAFKA_TOPIC_DLQ=pos.sales.dlq
KAFKA_TOPIC_ALERTS=pos.alerts
GATEWAY_ADDR=:8080

# Phase 3: data lake (a local folder laid out like a cloud bucket)
LAKE_ROOT=data/lake

# Phase 4: Snowflake (dedicated role, never ACCOUNTADMIN)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DUKAFLOW_PIPELINE
SNOWFLAKE_WAREHOUSE=DUKAFLOW_WH
SNOWFLAKE_DATABASE=DUKAFLOW
SNOWFLAKE_SCHEMA=RAW

# Phase 5: Gemini
GEMINI_API_KEY=

# Phase 6: API
API_CORS_ORIGINS=http://localhost:5173
